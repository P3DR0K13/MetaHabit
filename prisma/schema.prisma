generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id               String            @id @default(cuid())
  name             String
  email            String            @unique
  passwordHash     String            @map("password_hash")
  experiencePoints Int               @default(0) @map("experience_points")
  level            Int               @default(1)
  rank             String            @default("Iniciante")
  coins            Int               @default(0)
  createdAt        DateTime          @default(now()) @map("created_at")

  habits           Habit[]
  projects         Project[]
  activityRewards  ActivityReward[]
  rewards          Reward[]
  redemptions      RewardRedemption[]

  @@map("users")
}

model Habit {
  id          String     @id @default(cuid())
  userId      String     @map("user_id")
  name        String
  description String?
  frequency   String     @default("DAILY") // DAILY, WEEKLY, SPECIFIC_DAYS
  status      String     @default("ACTIVE") // ACTIVE, PAUSED, ARCHIVED
  createdAt   DateTime   @default(now()) @map("created_at")

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs        HabitLog[]

  @@map("habits")
}

model HabitLog {
  id            String   @id @default(cuid())
  habitId       String   @map("habit_id")
  completedDate String   @map("completed_date") // Formato YYYY-MM-DD
  status        String   @default("COMPLETED") // COMPLETED, FAILED, SKIPPED
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  habit         Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, completedDate])
  @@map("habit_logs")
}

model Project {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  title         String
  objective     String
  description   String?
  deadline      DateTime?
  availableTime String?   @map("available_time")
  difficulties  String?
  status        String    @default("IN_PROGRESS") // PLANNING, IN_PROGRESS, COMPLETED, ARCHIVED
  createdAt     DateTime  @default(now()) @map("created_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks         Task[]

  @@map("projects")
}

model Task {
  id               String    @id @default(cuid())
  projectId        String    @map("project_id")
  title            String
  description      String?
  dueDate          DateTime? @map("due_date")
  estimatedMinutes Int?      @map("estimated_minutes")
  priority         String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  difficulty       String    @default("MEDIUM") // EASY, MEDIUM, HARD
  status           String    @default("PENDING") // PENDING, COMPLETED, CANCELLED
  completedAt      DateTime? @map("completed_at")
  obstacle         String?
  createdAt        DateTime  @default(now()) @map("created_at")

  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

model ActivityReward {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  activityType     String   @map("activity_type") // HABIT, TASK
  activityId       String   @map("activity_id")
  experiencePoints Int      @map("experience_points")
  coins            Int
  createdAt        DateTime @default(now()) @map("created_at")

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activityType, activityId])
  @@map("activity_rewards")
}

model Reward {
  id          String             @id @default(cuid())
  userId      String             @map("user_id")
  name        String
  description String?
  coinCost    Int                @map("coin_cost")
  createdAt   DateTime           @default(now()) @map("created_at")

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  redemptions RewardRedemption[]

  @@map("rewards")
}

model RewardRedemption {
  id                   String   @id @default(cuid())
  rewardId             String   @map("reward_id")
  userId               String   @map("user_id")
  coinCostAtRedemption Int      @map("coin_cost_at_redemption")
  redeemedAt           DateTime @default(now()) @map("redeemed_at")

  reward               Reward   @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reward_redemptions")
}
